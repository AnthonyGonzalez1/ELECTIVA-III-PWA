+
+// ── Actividad 41.2: comprobar si la red LLEGA de verdad ─────────────────────────
+export type ResultadoRed = "llega" | "no llega" | "no hay red";
+
+/**
+ * Pide un archivo pequeño que el Service Worker NO responde desde su caché: una ficha de /modelos/ con un
+ * parámetro distinto cada vez. La ruta de /modelos/ del SW busca la petición en «modelos-3d» con su URL completa;
+ * con el parámetro nunca la encuentra y la pasa a la red. Sin el parámetro, una ficha ya descargada saldría de
+ * la caché y la respuesta sería siempre «llega», aunque el servidor estuviera caído (igual que con un archivo
+ * precacheado). `cache: "no-store"` evita además la caché HTTP del navegador. Cualquier respuesta del servidor,
+ * aunque sea un 404, prueba que la red llega; solo un error de red o el límite de tiempo dicen «no llega».
+ */
+export async function comprobarRed(limiteMs = 4000): Promise<ResultadoRed> {
+  if (!navigator.onLine) return "no hay red"; // «false» sí es fiable: no hay ninguna red conectada
+  const url = `${import.meta.env.BASE_URL}modelos/mvc.json?comprobar=${Date.now()}`;
+  try {
+    await fetch(url, { method: "HEAD", cache: "no-store", signal: AbortSignal.timeout(limiteMs) });
+    return "llega";
+  } catch {
+    return "no llega"; // TypeError (no se pudo conectar) o TimeoutError (no respondió a tiempo)
+  }
+}
