diff --git a/src/main.ts b/src/main.ts
index 42f829f..bc37a7b 100644
--- a/src/main.ts
+++ b/src/main.ts
@@ -575,6 +575,26 @@ btnSalirAR.addEventListener("click", () => {
 const btnInstalar = document.querySelector<HTMLButtonElement>("#btn-instalar")!;
 const estadoInstalacionEl = document.querySelector<HTMLElement>("#estado-instalacion")!;
 const estadoConexionEl = document.querySelector<HTMLElement>("#estado-conexion")!;
+// Actividad 41.1: «Ahora no» esconde la oferta de instalar y lo recuerda 7 días (sin tocar instalar.ts).
+const btnAhoraNo = document.querySelector<HTMLButtonElement>("#btn-ahora-no")!;
+const zonaInstalar = document.querySelector<HTMLElement>(".instalar-zona")!;
+const CLAVE_POSPUESTA = "atlas3d-instalar-pospuesta"; // guarda el instante (ms) en que se pulsó «Ahora no»
+const MS_POSPUESTA = 7 * 24 * 60 * 60 * 1000;
+
+/** Hasta cuándo está pospuesta la oferta, o null si no lo está (o ya pasaron los 7 días). */
+function pospuestaHasta(): number | null {
+  try {
+    const desde = Number(localStorage.getItem(CLAVE_POSPUESTA));
+    if (!desde) return null;
+    if (Date.now() - desde >= MS_POSPUESTA) {
+      localStorage.removeItem(CLAVE_POSPUESTA); // vencida: se olvida y la oferta vuelve a verse
+      return null;
+    }
+    return desde + MS_POSPUESTA;
+  } catch {
+    return null; // sin localStorage (modo privado estricto, almacenamiento bloqueado): no se recuerda
+  }
+}
 
 const TEXTO_INSTALACION = {
   instalada: "✓ Estás usando Atlas 3D como app instalada.",
@@ -587,6 +607,12 @@ const TEXTO_INSTALACION = {
 
 function pintarInstalacion(): void {
   const estado = estadoInstalacion();
+  // Actividad 41.1: con la oferta pospuesta, la sección entera desaparece (botón y texto): un texto que invita
+  // a instalar sin botón seguiría insistiendo. Solo afecta al estado «instalable»; «instalada», «recién
+  // instalada» o «iOS» se siguen mostrando, porque informan y no piden nada.
+  const pospuesta = estado === "instalable" && pospuestaHasta() !== null;
+  zonaInstalar.hidden = pospuesta;
+  btnAhoraNo.hidden = estado !== "instalable" || pospuesta;
   btnInstalar.hidden = estado !== "instalable";
   estadoInstalacionEl.textContent =
     estado === "instalada" ? TEXTO_INSTALACION.instalada
@@ -605,6 +631,15 @@ btnInstalar.addEventListener("click", async () => {
     btnInstalar.disabled = false;
   }
 });
+btnAhoraNo.addEventListener("click", () => {
+  try {
+    localStorage.setItem(CLAVE_POSPUESTA, String(Date.now()));
+  } catch {
+    /* sin almacenamiento: se esconde solo durante esta visita */
+    zonaInstalar.hidden = true;
+  }
+  pintarInstalacion();
+});
 iniciarInstalacion(pintarInstalacion);
 
 let estuvoSinConexion = false;
